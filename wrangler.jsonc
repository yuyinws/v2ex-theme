{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "v2ex-theme",
	"compatibility_date": "2026-11-21",
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true
	},
	// Theme likes.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "v2ex-theme",
			"database_id": "d29b5154-7946-4114-90d8-f9197374df0c",
			"migrations_dir": "migrations"
		}
	],
	// Per-IP throttle on like writes; it slows scripts down rather than identifying people.
	"ratelimits": [
		{
			"name": "LIKE_LIMITER",
			"namespace_id": "1001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		}
	],
	// Keep PR previews isolated from production bindings; loaders degrade gracefully without D1.
	"previews": {}
}
